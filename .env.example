# MUVI Backend - .env.example
# Copia este archivo a .env y completa los valores.

# ---- General ----
NODE_ENV=development
PORT=4006
SESSIONS_SECRET=replace_with_a_secure_random_string
HOST_URL=http://localhost:4006   # base URL del backend (usado para SAML callbacks)
CLIENT_URL=http://localhost:3000 # URL del frontend (CORS y enlaces de email)

# ---- Auth / JWT ----
PASSPORT_STRATEGY=saml           # opcional: 'saml' si vas a usar SAML
JWT_SECRET=replace_with_a_jwt_secret

# ---- SAML (si usas SAML) ----
# Si SAML está habilitado, asegúrate de tener los certificados en ./certs
SAML_ISSUER=https://your-saml-issuer
SAML_ENTRY_POINT=https://idp.example.com/saml2/idp/SSOService.php
SAML_LOGOUT_URL=https://idp.example.com/saml2/idp/SingleLogoutService.php
SAML_CALLBACK_URL=/login/callback
SAML_LOGOUT_CALLBACK_URL=/api/auth/logout/callback

# ---- Database / Prisma ----
# URL de conexión PostgreSQL para Prisma
DB_URL=postgresql://postgres:password@localhost:5432/postgres
# Opcionales para docker-compose local (solo si usas docker-compose)
DB_HOST=database
DB_PASSWORD=admin

# ---- MercadoPago ----
MERCADO_PAGO_ACCESS_TOKEN=replace_with_mercadopago_access_token
MP_PREFERENCE_SUCCESS_URL=http://localhost:3000/cart/
MP_PREFERENCE_FAILURE_URL=http://localhost:3000/cart/
MP_PREFERENCE_PENDING_URL=http://localhost:3000/cart/

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
# CLOUDINARY_URL is optional and not required by the code
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>

# ---- Email (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASS=replace_with_smtp_password

# ---- Mailtrap (opcional) ----
# Si prefieres usar Mailtrap en lugar de SMTP, define MAILTRAP_TOKEN
MAILTRAP_TOKEN=replace_with_mailtrap_token

# -------------------------------
# NOTAS:
# - No dejes secretos reales en repositorios públicos.
# - Ajusta las URLs y credenciales según tu entorno (dev / staging / production).
# - Las variables marcadas 'opcional' solo son necesarias si activas la funcionalidad correspondiente.
